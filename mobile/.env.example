EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep mock voice on by default for fresh clones with no OpenAI key.
# Set this to false to use the FastAPI /voice-report endpoint instead of
# Supabase. EXPO_PUBLIC_API_BASE_URL must point at a running backend whose
# .env has OPENAI_API_KEY configured.
EXPO_PUBLIC_USE_MOCK_VOICE_API=true
# Sanketak FastAPI backend. Use the LAN IP of the machine running Docker when
# testing on a physical phone -- localhost only resolves on the same machine
# or the iOS simulator. Example: http://192.168.1.24:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
