# Legacy Supabase voice path. Leave both blank to use the FastAPI backend,
# which is the supported path. They are only read when
# EXPO_PUBLIC_API_BASE_URL is unset.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Sanketak FastAPI backend. Voice reports are transcribed by its /voice-report
# endpoint, so its .env needs a real OPENAI_API_KEY. Use the LAN IP of the
# machine running Docker when testing on a physical phone -- localhost only
# resolves on the same machine or the iOS simulator.
# Example: http://192.168.1.24:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
